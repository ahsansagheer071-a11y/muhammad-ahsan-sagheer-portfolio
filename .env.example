# ==========================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==========================================

# 1. Destination Email (where inquiry notifications are sent)
CONTACT_EMAIL=ahsansagheer18@gmail.com

# 2. Site Base URL (used for canonical URLs, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://ahsansagheer.com

# 3. Email Delivery via Resend (https://resend.com)
# Create a free API Key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# (Optional) Verified sender email in Resend
# If using Resend default free tier: "onboarding@resend.dev"
# If you have verified a domain: "Portfolio <inquiries@yourdomain.com>"
RESEND_FROM_EMAIL=Portfolio Inquiry <onboarding@resend.dev>

# ==========================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ==========================================

# 1. Site Base URL (used for canonical URLs, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://ahsansagheer.com

# 2. Email Delivery via Resend (Optional for instant live email dispatch)
# Sign up free at https://resend.com and create an API Key.
# If not set, inquiries are safely logged on the server.
RESEND_API_KEY=re_your_api_key_here

# (Optional) Verified sender email configured in your Resend domain.
# Defaults to "Portfolio Inquiry <onboarding@resend.dev>"
RESEND_FROM_EMAIL=Portfolio Inquiry <onboarding@resend.dev>
